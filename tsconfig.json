{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "sourceMap": true,
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // ToDo: Set this to strict and fix the resulting breakages
    "strict": false,
    "skipLibCheck": true
  }
}
